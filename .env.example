# Nusxasini .env nomi bilan saqlang va o'z manzillaringizni yozing (oxirida "/" bo'lmasin).
# Mijozlar (register) va abonementlar (data) resurslari:
VITE_API_URL=https://XXXXXXXX.mockapi.io/api/v1
# Adminlar (admins) va chiqimlar (expenses) resurslari, boshqa akkauntdagi loyiha:
VITE_ADMIN_API_URL=https://YYYYYYYY.mockapi.io/api/v1